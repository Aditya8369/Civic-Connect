rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isComplaintOwner(complaintId) {
      return isAuthenticated() && (
        !firestore.exists(/databases/(default)/documents/issues/$(complaintId)) ||
        firestore.get(/databases/(default)/documents/issues/$(complaintId)).data.reportedBy == request.auth.uid
      );
    }

    // Complaint photo attachments
    match /complaint-photos/{complaintId}/{fileName} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png)');

      allow update: if false;

      allow delete: if isAdmin() || isComplaintOwner(complaintId);
    }

    // Complaint voice recordings
    match /complaint-audio/{complaintId}/{fileName} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'audio/(webm|ogg|mp4|wav|x-wav|mpeg|aac)'
        );

      allow update: if false;

      allow delete: if isAdmin() || isComplaintOwner(complaintId);
    }

    // Resolution feedback attachments (photo or audio evidence)
    match /resolution-feedback/{userId}/{issueId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|jpg|png)') ||
          request.resource.contentType.matches(
            'audio/(webm|ogg|mp4|wav|x-wav|mpeg|aac)'
          )
        );

      allow update: if false;

      allow delete: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    // Deny access to every other storage path
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
