# CivicConnect Environment Variables Template
# Copy this file to .env for local development.

# Default: Development Firebase project
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForLocalDevelopmentAndPreview00
VITE_FIREBASE_AUTH_DOMAIN=civicconnect-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civicconnect-dev
VITE_FIREBASE_STORAGE_BUCKET=civicconnect-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_USE_EMULATORS=false

# Alternative: Firebase Emulator Suite
# Uncomment these settings when using the local emulators.
# VITE_FIREBASE_API_KEY=demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-civic-connect.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-civic-connect
# VITE_FIREBASE_STORAGE_BUCKET=demo-civic-connect.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# VITE_USE_EMULATORS=true
