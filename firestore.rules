rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Shared authorization & validation helpers
    // ---------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role verification: prioritize cryptographically signed Custom Auth Claims
    // with a graceful fallback for local emulators and legacy un-migrated accounts.
    // The users document is immutable for 'role', so the fallback cannot be exploited.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', null) == 'admin' ||
        (request.auth.token.get('role', null) == null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'admin')
      );
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isOptionalLatitude(value) {
      return value == null || (value is number && value >= -90 && value <= 90);
    }

    function isOptionalLongitude(value) {
      return value == null || (value is number && value >= -180 && value <= 180);
    }

    function isOptionalMap(value) {
      return value == null || value is map;
    }

    // ---------------------------------------------------------------------
    // User profiles (/users/{userId})
    // ---------------------------------------------------------------------

    match /users/{userId} {
      function isSelf() {
        return isAuthenticated() && request.auth.uid == userId;
      }

      function isValidRegistration() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'email', 'role', 'createdAt']) &&
               data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
               isNonEmptyString(data.name, 100) &&
               isNonEmptyString(data.email, 200) &&
               // Public self-registration is strictly role: 'citizen'. Client cannot elevate to admin.
               data.role == 'citizen' &&
               data.createdAt == request.time;
      }

      function isValidNotificationPreferences(value) {
        return value is map &&
               value.keys().hasOnly(['sound', 'push', 'emailDigest']) &&
               (!value.keys().hasAny(['sound']) || value.sound is bool) &&
               (!value.keys().hasAny(['push']) || value.push is bool) &&
               (!value.keys().hasAny(['emailDigest']) || value.emailDigest is bool);
      }

      function isValidProfileUpdate() {
        let data = request.resource.data;
        let previous = resource.data;
        let changed = data.diff(previous).affectedKeys();
        return changed.hasOnly([
                 'name', 'phone', 'address', 'updatedAt', 'fcmToken',
                 'pushNotificationsEnabled', 'notificationPreferences'
               ]) &&
               // Identity and role authorization attributes are immutable.
               data.get('role', null) == previous.get('role', null) &&
               data.get('email', null) == previous.get('email', null) &&
               data.get('createdAt', null) == previous.get('createdAt', null) &&
               (!changed.hasAny(['name']) || isNonEmptyString(data.get('name', null), 100)) &&
               isOptionalString(data.get('phone', null), 20) &&
               isOptionalString(data.get('address', null), 300) &&
               isOptionalString(data.get('fcmToken', null), 4096) &&
               data.get('pushNotificationsEnabled', false) is bool &&
               isValidNotificationPreferences(data.get('notificationPreferences', {}));
      }

      allow read: if isSelf() || isAdmin();
      // Self-registration strictly enforces 'citizen' role and schema.
      allow create: if isSelf() && isValidRegistration();
      // Profile updates may not change role, email, or creation metadata.
      allow update: if isSelf() && isValidProfileUpdate();
      allow delete: if false;

      match /offlineComplaintReceipts/{localId} {
        function matchesUploadedComplaint() {
          let issuePath = /databases/$(database)/documents/issues/$(localId);
          let uploaded = getAfter(issuePath);
          return uploaded.data.reportedBy == userId &&
                 (!exists(issuePath) || uploaded.data == get(issuePath).data);
        }

        allow get: if isSelf();
        allow create: if isSelf() &&
                      request.resource.data.keys().hasOnly(['createdAt']) &&
                      request.resource.data.createdAt == request.time &&
                      matchesUploadedComplaint();
        allow list, update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Complaints & Grievances (/issues/{issueId})
    // ---------------------------------------------------------------------

    match /issues/{issueId} {
      function isValidComplaintCreate() {
        let data = request.resource.data;
        let allowedFields = [
          'complaintId', 'title', 'description', 'category', 'address',
          'latitude', 'longitude', 'status', 'department', 'reportedBy',
          'imageUrl', 'photos', 'audioNote', 'endorsedBy', 'endorsementCount',
          'upvotedBy', 'upvotesCount', 'createdAt', 'updatedAt',
          'wardId', 'ward', 'wardName', 'zoneName'
        ];
        // Workflow, assignment, audit and social fields may only be produced by
        // server-side/admin workflows. A reporter starts from a clean Pending doc.
        return data.keys().hasOnly(allowedFields) &&
               data.keys().hasAll(['title', 'description', 'category', 'status', 'reportedBy', 'createdAt', 'updatedAt']) &&
               data.reportedBy == request.auth.uid &&
               data.status == 'Pending' &&
               data.get('department', '') == '' &&
               (!data.keys().hasAny(['complaintId']) ||
                 (data.complaintId is string &&
                  data.complaintId.matches('^CMP-[0-9]{4}-[0-9]{4,6}$'))) &&
               isNonEmptyString(data.title, 200) &&
               isNonEmptyString(data.description, 2000) &&
               isNonEmptyString(data.category, 50) &&
               isOptionalString(data.get('address', null), 300) &&
               isOptionalLatitude(data.get('latitude', null)) &&
               isOptionalLongitude(data.get('longitude', null)) &&
               isOptionalString(data.get('wardId', null), 50) &&
               isOptionalString(data.get('ward', null), 50) &&
               isOptionalString(data.get('wardName', null), 100) &&
               isOptionalString(data.get('zoneName', null), 100) &&
               (data.get('imageUrl', null) == null ||
                 (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
               (data.get('photos', []) is list && data.get('photos', []).size() <= 5) &&
               isOptionalMap(data.get('audioNote', null)) &&
               (data.get('endorsedBy', []) is list && data.get('endorsedBy', []).size() == 0) &&
               data.get('endorsementCount', 0) == 0 &&
               (data.get('upvotedBy', []) is list && data.get('upvotedBy', []).size() == 0) &&
               data.get('upvotesCount', 0) == 0 &&
               data.createdAt == request.time &&
               data.updatedAt == request.time;
      }

      function isValidCitizenPendingEdit() {
        let data = request.resource.data;
        let previous = resource.data;
        let changed = data.diff(previous).affectedKeys();
        let allowedFields = [
          'title', 'description', 'category', 'address',
          'latitude', 'longitude', 'imageUrl', 'photos', 'audioNote', 'updatedAt'
        ];
        return previous.status == 'Pending' &&
               data.status == 'Pending' &&
               changed.hasOnly(allowedFields) &&
               // Protected fields are strictly immutable during citizen edit
               data.reportedBy == previous.reportedBy &&
               data.get('complaintId', '') == previous.get('complaintId', '') &&
               data.get('department', '') == previous.get('department', '') &&
               data.get('assignedWorker', null) == previous.get('assignedWorker', null) &&
               data.get('assignedOfficer', null) == previous.get('assignedOfficer', null) &&
               data.get('createdAt', null) == previous.get('createdAt', null) &&
               data.get('endorsedBy', []) == previous.get('endorsedBy', []) &&
               data.get('endorsementCount', 0) == previous.get('endorsementCount', 0) &&
               data.get('upvotedBy', []) == previous.get('upvotedBy', []) &&
               data.get('upvotesCount', 0) == previous.get('upvotesCount', 0) &&
               data.get('wardId', null) == previous.get('wardId', null) &&
               data.get('ward', null) == previous.get('ward', null) &&
               data.get('wardName', null) == previous.get('wardName', null) &&
               data.get('zoneName', null) == previous.get('zoneName', null) &&
               (!changed.hasAny(['title']) || isNonEmptyString(data.title, 200)) &&
               (!changed.hasAny(['description']) || isNonEmptyString(data.description, 2000)) &&
               (!changed.hasAny(['category']) || isNonEmptyString(data.category, 50)) &&
               isOptionalString(data.get('address', null), 300) &&
               isOptionalLatitude(data.get('latitude', null)) &&
               isOptionalLongitude(data.get('longitude', null)) &&
               (data.get('imageUrl', null) == null ||
                 (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
               (data.get('photos', []) is list && data.get('photos', []).size() <= 5) &&
               isOptionalMap(data.get('audioNote', null)) &&
               data.updatedAt == request.time;
      }

      function isResolutionFeedback() {
        let feedback = request.resource.data.get('feedback', {});
        let allowedTags = ['Quick response', 'Courteous staff', 'Clean finish'];
        let tags = feedback.get('tags', []);
        let comment = feedback.get('comment', '');
        let attachment = feedback.get('attachment', null);
        return resource.data.status == 'Resolved' &&
               resource.data.get('feedback', null) == null &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['feedback', 'updatedAt']) &&
               feedback.keys().hasOnly(['rating', 'tags', 'comment', 'attachment', 'submittedAt']) &&
               feedback.rating is int && feedback.rating >= 1 && feedback.rating <= 5 &&
               tags is list && tags.hasOnly(allowedTags) &&
               tags.size() == tags.toSet().size() &&
               comment is string && comment.size() <= 1000 &&
               feedback.submittedAt == request.time && request.resource.data.updatedAt == request.time &&
               (attachment == null ||
                 (attachment.keys().hasOnly(['kind', 'path']) &&
                  attachment.kind in ['photo', 'voice'] &&
                  attachment.path is string &&
                  attachment.path.matches('resolution-feedback/' + request.auth.uid + '/' + issueId + '/[0-9a-f-]{36}')));
      }

      function isCitizenAppeal() {
        let resolvedAt = resource.data.get('resolvedAt', null);
        let reason = request.resource.data.get('reopenReason', null);
        return resource.data.status == 'Resolved' &&
               request.resource.data.status == 'Reopened' &&
               resolvedAt is timestamp &&
               resolvedAt <= request.time &&
               request.time <= resolvedAt + duration.value(7, 'd') &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'reopenReason', 'reopenedAt', 'updatedAt']) &&
               reason is string && reason.size() <= 1000 &&
               !reason.matches('[\\s\\p{Z}\\x0B\\x{FEFF}]*') &&
               request.resource.data.get('reopenedAt', null) == request.time &&
               request.resource.data.get('updatedAt', null) == request.time;
      }

      function isCitizenAcceptResolution() {
        let deadline = resource.data.get('verificationDeadline', null);
        let diff = request.resource.data.diff(resource.data);
        return resource.data.status == 'Pending Verification' &&
               request.resource.data.status == 'Resolved' &&
               (deadline == null || request.time <= deadline) &&
               diff.affectedKeys().hasOnly(['status', 'resolvedAt', 'updatedAt', 'acceptedBy', 'acceptedAt', 'feedback']) &&
               request.resource.data.get('acceptedBy', null) == request.auth.uid &&
               request.resource.data.get('acceptedAt', null) == request.time &&
               request.resource.data.get('resolvedAt', null) == request.time &&
               request.resource.data.get('updatedAt', null) == request.time;
      }

      function isCitizenDisputeResolution() {
        let deadline = resource.data.get('verificationDeadline', null);
        let diff = request.resource.data.diff(resource.data);
        let disputeData = request.resource.data.get('dispute', {});
        let allowedReasons = ['WORK_INCOMPLETE', 'INCORRECT_LOCATION', 'POOR_QUALITY', 'OTHER'];
        return resource.data.status == 'Pending Verification' &&
               request.resource.data.status == 'Disputed' &&
               (deadline == null || request.time <= deadline) &&
               diff.affectedKeys().hasOnly(['status', 'dispute', 'disputedAt', 'updatedAt', 'disputeCount']) &&
               disputeData is map &&
               disputeData.get('reason', '') in allowedReasons &&
               isNonEmptyString(disputeData.get('explanation', ''), 2000) &&
               disputeData.get('disputedBy', '') == request.auth.uid &&
               request.resource.data.get('disputedAt', null) == request.time &&
               request.resource.data.get('updatedAt', null) == request.time;
      }

      function isCitizenUpvote() {
        let diff = request.resource.data.diff(resource.data);
        let currentCount = resource.data.get('upvotesCount', 0);
        let newCount = request.resource.data.get('upvotesCount', 0);
        let prevUpvotedBy = resource.data.get('upvotedBy', []);
        let nextUpvotedBy = request.resource.data.get('upvotedBy', []);

        return diff.affectedKeys().hasOnly(['upvotedBy', 'upvotesCount', 'updatedAt']) &&
               request.resource.data.reportedBy == resource.data.reportedBy &&
               request.resource.data.status == resource.data.status &&
               prevUpvotedBy is list && nextUpvotedBy is list &&
               newCount is int && newCount >= 0 &&
               (!diff.affectedKeys().hasAny(['updatedAt']) ||
                 request.resource.data.updatedAt == request.time) &&
               (
                 // Adding an upvote: only the caller's UID may be appended.
                 (newCount == currentCount + 1 &&
                  !(request.auth.uid in prevUpvotedBy) &&
                  nextUpvotedBy == prevUpvotedBy.concat([request.auth.uid])) ||
                 // Removing an upvote: only the caller's UID may be removed.
                 (newCount == (currentCount > 0 ? currentCount - 1 : 0) &&
                  request.auth.uid in prevUpvotedBy &&
                  nextUpvotedBy == prevUpvotedBy.removeAll([request.auth.uid]))
               );
      }

      function isCitizenEndorsement() {
        let diff = request.resource.data.diff(resource.data);
        let currentCount = resource.data.get('endorsementCount', 0);
        let newCount = request.resource.data.get('endorsementCount', 0);
        let prevEndorsedBy = resource.data.get('endorsedBy', []);
        let nextEndorsedBy = request.resource.data.get('endorsedBy', []);

        return diff.affectedKeys().hasOnly(['endorsedBy', 'endorsementCount', 'updatedAt']) &&
               request.resource.data.reportedBy == resource.data.reportedBy &&
               request.resource.data.status == resource.data.status &&
               prevEndorsedBy is list && nextEndorsedBy is list &&
               newCount is int && newCount >= 0 &&
               newCount == currentCount + 1 &&
               !(request.auth.uid in prevEndorsedBy) &&
               nextEndorsedBy == prevEndorsedBy.concat([request.auth.uid]) &&
               request.resource.data.updatedAt == request.time;
      }

      // Complaints are community-visible to signed-in residents (CommunityFeed,
      // public map, duplicate detection and consolidated-ticket lookup). Private
      // collections such as profiles, notifications and offline receipts remain
      // strictly owner-scoped below.
      allow read: if isAuthenticated();

      // Complaint creation is strictly Pending and owned by the author
      allow create: if isAuthenticated() && isValidComplaintCreate();

      // Citizen updates are restricted to Pending edits, appeals, feedback, resolution acceptance/dispute, or voting; admins have full workflow access
      allow update: if (isAuthenticated() && (
                        (resource.data.reportedBy == request.auth.uid &&
                          (isValidCitizenPendingEdit() || isCitizenAppeal() || isResolutionFeedback() || isCitizenAcceptResolution() || isCitizenDisputeResolution())) ||
                        isCitizenUpvote() ||
                        isCitizenEndorsement()
                      )) || isAdmin();

      // Deletion is strictly restricted to complaints in Pending status owned by the reporter
      allow delete: if isAuthenticated() &&
                    resource.data.reportedBy == request.auth.uid &&
                    resource.data.status == 'Pending';

      // Community discussion comments sub-collection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      request.resource.data.keys().hasOnly(['text', 'authorName', 'authorId', 'createdAt']) &&
                      request.resource.data.authorId == request.auth.uid &&
                      isNonEmptyString(request.resource.data.text, 1000) &&
                      (request.resource.data.get('authorName', null) == null ||
                        isNonEmptyString(request.resource.data.get('authorName', null), 100)) &&
                      request.resource.data.createdAt == request.time;
        allow update: if isAuthenticated() &&
                      resource.data.authorId == request.auth.uid &&
                      request.resource.data.authorId == resource.data.authorId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
                      isNonEmptyString(request.resource.data.text, 1000) &&
                      request.resource.data.get('updatedAt', null) == request.time;
        allow delete: if isAuthenticated() &&
                      (resource.data.authorId == request.auth.uid || isAdmin());
      }

      // Immutable event audit trail sub-collection
      match /events/{eventId} {
        function isValidEventSchema() {
          let data = request.resource.data;
          let allowedActions = [
            'Complaint submitted',
            'Status changed',
            'Department assigned',
            'Field worker designated',
            'Resolution notes updated',
            'Complaint merged',
            'Duplicate complaint consolidated',
            'Citizen appeal',
            'Resolution submitted for verification',
            'Resolution accepted',
            'Resolution disputed',
            'Resolution auto-verified',
            'Dispute reviewed',
            'Evidence retention erasure',
            'Retention hold applied',
            'Retention hold released'
          ];
          return data.keys().hasOnly(['timestamp', 'actorUid', 'action', 'previousStatus', 'newStatus', 'remarks']) &&
                 data.keys().hasAll(['timestamp', 'action', 'actorUid']) &&
                 data.actorUid == request.auth.uid &&
                 data.action in allowedActions &&
                 data.timestamp == request.time &&
                 (data.get('remarks', '') is string && data.get('remarks', '').size() <= 1000) &&
                 isOptionalString(data.get('previousStatus', null), 50) &&
                 isOptionalString(data.get('newStatus', null), 50);
        }

        function isComplaintAuthor() {
          let issuePath = /databases/$(database)/documents/issues/$(issueId);
          return getAfter(issuePath).data.reportedBy == request.auth.uid;
        }

        function isAuthorizedEventCreator() {
          let issuePath = /databases/$(database)/documents/issues/$(issueId);
          let data = request.resource.data;
          let action = data.action;
          // Citizens may only append events that mirror the lifecycle transition
          // committed in the same write (creation, a Resolved -> Reopened appeal, or resolution acceptance/dispute).
          let citizenAllowed = isComplaintAuthor() && (
            (action == 'Complaint submitted' &&
              data.get('newStatus', null) == 'Pending' &&
              getAfter(issuePath).data.status == 'Pending') ||
            ((action == 'Citizen appeal' || action == 'Status changed') &&
              data.get('newStatus', null) == 'Reopened' &&
              getAfter(issuePath).data.status == 'Reopened' &&
              exists(issuePath) &&
              get(issuePath).data.status == 'Resolved') ||
            ((action == 'Resolution accepted' || action == 'Status changed') &&
              data.get('newStatus', null) == 'Resolved' &&
              getAfter(issuePath).data.status == 'Resolved' &&
              exists(issuePath) &&
              get(issuePath).data.status == 'Pending Verification') ||
            ((action == 'Resolution disputed' || action == 'Status changed') &&
              data.get('newStatus', null) == 'Disputed' &&
              getAfter(issuePath).data.status == 'Disputed' &&
              exists(issuePath) &&
              get(issuePath).data.status == 'Pending Verification')
          );
          return isAdmin() || citizenAllowed;
        }

        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      isValidEventSchema() &&
                      isAuthorizedEventCreator();
        allow update, delete: if false;
      }
    }

    // Platform configuration
    match /settings/{settingId} {
      function isValidResolutionTemplates() {
        let data = request.resource.data;
        return data.keys().hasOnly(['templates', 'updatedAt', 'updatedBy']) &&
               data.templates is list &&
               data.templates.size() <= 50 &&
               data.updatedAt == request.time &&
               (!data.keys().hasAny(['updatedBy']) || data.updatedBy == request.auth.uid);
      }

      allow read: if isAdmin() ||
                    (isAuthenticated() && settingId == 'resolutionTemplates');
      allow write: if isAdmin() &&
                    (settingId != 'resolutionTemplates' || isValidResolutionTemplates());
    }

    // Notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      function isValidNotificationCreate() {
        let data = request.resource.data;
        return data.keys().hasOnly([
                 'recipientRole', 'recipientUid', 'senderUid', 'issueId', 'type',
                 'title', 'message', 'read', 'createdAt'
               ]) &&
               data.senderUid == request.auth.uid &&
               data.read == false &&
               data.createdAt == request.time &&
               data.recipientRole in ['admin', 'citizen'] &&
               data.type in ['new_complaint', 'status_update', 'department_assigned'] &&
               isNonEmptyString(data.issueId, 40) &&
               isNonEmptyString(data.title, 200) &&
               isNonEmptyString(data.message, 1000) &&
               // Admin-desk notices are broadcast (no recipientUid); a direct
               // citizen notice must name exactly one recipient.
               (data.recipientRole == 'admin'
                 ? data.get('recipientUid', null) == null
                 : (data.get('recipientUid', null) is string &&
                    data.recipientUid.size() > 0 &&
                    data.recipientUid.size() <= 128));
      }

      allow read: if isAuthenticated() &&
                  (resource.data.get('recipientUid', null) == request.auth.uid ||
                   (resource.data.get('recipientRole', null) == 'admin' && isAdmin()));

      // Citizens can only notify admin desk. Administrators can notify specific citizen recipients.
      allow create: if isAuthenticated() &&
                    isValidNotificationCreate() &&
                    (isAdmin() ||
                     (request.resource.data.recipientRole == 'admin' &&
                      request.resource.data.get('recipientUid', null) == null));

      // Notification update strictly allows toggling read state on own notification
      allow update: if isAuthenticated() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                    request.resource.data.read is bool &&
                    (resource.data.get('recipientUid', null) == request.auth.uid ||
                     (resource.data.get('recipientRole', null) == 'admin' && isAdmin()));

      allow delete: if false;
    }

    // Emergency broadcasts (/broadcasts/{broadcastId})
    match /broadcasts/{broadcastId} {
      function isValidBroadcastCreate() {
        let data = request.resource.data;
        return data.keys().hasOnly([
                 'title', 'message', 'severity', 'active',
                 'createdAt', 'createdBy'
               ]) &&
               isNonEmptyString(data.title, 120) &&
               isNonEmptyString(data.message, 600) &&
               data.severity in ['info', 'warning', 'critical'] &&
               data.active == true &&
               data.createdAt == request.time &&
               data.get('createdBy', request.auth.uid) == request.auth.uid;
      }

      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidBroadcastCreate();
      allow update, delete: if isAdmin();
    }

    // Sequential complaint ID counters (/counters/{counterId})
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      // Counter must start at 1 and advance strictly by exactly +1 (monotonic non-decreasing)
      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasOnly(['lastNumber']) &&
                    request.resource.data.lastNumber is int &&
                    request.resource.data.lastNumber == 1;
      allow update: if isAuthenticated() &&
                    request.resource.data.keys().hasOnly(['lastNumber']) &&
                    request.resource.data.lastNumber is int &&
                    resource.data.lastNumber is int &&
                    request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }

    // Gamification leaderboard projections (/leaderboard/{userId})
    // NOTE: scores are a deterministic projection of public complaint data and
    // are recomputed client-side from issues the caller can already read. Rules
    // can validate shape/ownership/bounds but cannot aggregate issues to prove
    // a score is honest; server-authoritative aggregation is tracked as a
    // residual risk in the Issue #20 report.
    match /leaderboard/{userId} {
      function isValidLeaderboardEntry() {
        let data = request.resource.data;
        let allowedKeys = [
          'uid', 'name', 'displayName', 'monthlyScore',
          'allTimeScore', 'badgesCount', 'reportsCount', 'level', 'updatedAt'
        ];
        return data.keys().hasOnly(allowedKeys) &&
               data.uid == userId &&
               data.get('name', '') is string &&
               data.get('name', '').size() <= 100 &&
               data.get('displayName', '') is string &&
               data.get('displayName', '').size() <= 100 &&
               data.get('monthlyScore', 0) is number &&
               data.get('monthlyScore', 0) >= 0 &&
               data.get('monthlyScore', 0) <= 100000000 &&
               data.get('allTimeScore', 0) is number &&
               data.get('allTimeScore', 0) >= 0 &&
               data.get('allTimeScore', 0) <= 100000000 &&
               data.get('monthlyScore', 0) <= data.get('allTimeScore', 0) &&
               data.get('badgesCount', 0) is number &&
               data.get('badgesCount', 0) >= 0 &&
               data.get('badgesCount', 0) <= 100 &&
               data.get('reportsCount', 0) is number &&
               data.get('reportsCount', 0) >= 0 &&
               data.get('reportsCount', 0) <= 100000 &&
               data.get('level', 1) is number &&
               data.get('level', 1) >= 1 &&
               data.get('level', 1) <= 100 &&
               data.get('updatedAt', null) == request.time;
      }

      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                            (request.auth.uid == userId || isAdmin()) &&
                            isValidLeaderboardEntry();
      allow delete: if isAdmin();
    }

    // Field Officers collection (/officers/{officerId})
    // Only authorized municipal administrators may read and manage officer records.
    // Protects officer personal information (phone, email) and prevents unauthorized tampering.
    match /officers/{officerId} {
      allow read, write: if isAdmin();
    }
  }
}
